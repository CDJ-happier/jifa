[Unit]
Description=Jifa - Java Issues Finding Assistant
Documentation=https://eclipse-jifa.github.io/jifa/
After=network.target

[Service]
Type=simple
User=jifa
Group=jifa

# 工作目录
WorkingDirectory=/data/jifa/app/jifa

# 启动脚本
ExecStart=/bin/bash /data/jifa/start-jifa.sh

# 停止超时（秒）
TimeoutStopSec=60

# 自动重启配置
Restart=on-failure
RestartSec=10

# 标准输出和错误输出
StandardOutput=journal
StandardError=journal

# 资源限制
# 最大打开文件数
LimitNOFILE=65536
# 最大进程数
LimitNPROC=65536

# 安全配置
# 禁止提升权限
NoNewPrivileges=true
# 私有临时目录
PrivateTmp=true

# 环境变量（可选，启动脚本中已配置）
Environment="JAVA_HOME=/opt/java17-jifa"
Environment="PATH=/opt/java17-jifa/bin:/usr/local/bin:/usr/bin:/bin"

[Install]
WantedBy=multi-user.target
